{
  "platform": "linux-x86_64",
  "language": "c++26",
  "gcc_series": "16.2.x",
  "validated_gcc": "16.2.1 20260810 (Arch Linux)",
  "xmake_minimum": "3.1.2",
  "validated_xmake": "3.1.2",
  "import_std": false,
  "validated_dependencies": {
    "libraw": "0.22.2",
    "libtiff-4": "4.7.2",
    "libturbojpeg": "3.2.0",
    "lcms2": "2.19",
    "OpenEXR": "3.5.2"
  },
  "validated_clang_format": "23.1.3",
  "contracts": {
    "compile_flags": [
      "-fcontracts",
      "-fcontract-evaluation-semantic=quick_enforce"
    ],
    "link_flags": [
      "-fcontracts"
    ],
    "template_preconditions": "contract_assert, verified with subprocess termination tests"
  },
  "dependency_path": "arch-system",
  "optional_dependency_path": "PHOTO_OPS_DEPS=brew",
  "formatting": "stock clang-format; no custom C++ lexical pass"
}
